{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:hosted",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/book/:chapter(iesc1(?:0[1-9]|1[0-3])).pdf",
      "destination": "https://ncert.nic.in/textbook/pdf/:chapter.pdf"
    }
  ]
}
